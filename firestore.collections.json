{
  "projectId": "employee-management-port-339fe",
  "databaseId": "(default)",
  "note": "Firestore creates collections on the first document write. This file documents the collection schema; it is not a SQL migration.",
  "collections": {
    "employees": {
      "documentId": "Firebase Authentication UID",
      "requiredFields": {
        "uid": "string",
        "employeeCode": "string",
        "fullName": "string",
        "phone": "string",
        "email": "string",
        "role": "admin | manager | employee",
        "status": "active | inactive",
        "joinDate": "timestamp",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
    "workSchedules": {
      "documentId": "auto",
      "requiredFields": {
        "employeeId": "string",
        "date": "timestamp",
        "shift": "Morning | Afternoon | Evening",
        "status": "Registered (legacy) | Pending | ChangesRequested | Approved | Rejected | Cancelled",
        "note": "string",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "optionalFields": ["reviewNote", "reviewedBy", "reviewedAt", "lockedAt", "cancelledBy", "cancelledAt"]
    },
    "leaveRequests": {
      "documentId": "auto",
      "requiredFields": {
        "employeeId": "string",
        "leaveDate": "timestamp",
        "leaveType": "sick | casual | earned | personal",
        "reason": "string",
        "status": "Pending | Approved | Rejected | Cancelled",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "optionalFields": ["workScheduleId", "endDate", "duration (short | long)", "approvedBy", "reviewNote", "reviewedBy", "reviewedAt", "revisedAt", "cancelledBy", "cancelledAt"]
    },
    "lateRequests": {
      "documentId": "auto",
      "requiredFields": {
        "employeeId": "string",
        "workScheduleId": "string",
        "date": "timestamp",
        "shift": "Morning | Afternoon | Evening",
        "lateMinutes": "integer",
        "reason": "string",
        "status": "Pending | Approved | Rejected | Cancelled",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "optionalFields": ["expectedArrival", "approvedBy", "reviewNote", "reviewedBy", "reviewedAt", "revisedAt", "cancelledBy", "cancelledAt"]
    },
    "salaryAdvances": {
      "documentId": "auto",
      "requiredFields": {
        "employeeId": "string",
        "amount": "number",
        "reason": "string",
        "status": "Pending | Approved | Rejected | Cancelled",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "optionalFields": ["approvedBy", "reviewNote", "reviewedBy", "reviewedAt", "revisedAt", "cancelledBy", "cancelledAt"]
    },
    "penalties": {
      "documentId": "auto",
      "requiredFields": {
        "employeeId": "string",
        "title": "string",
        "description": "string",
        "category": "Late | Probation | Performance | Other",
        "amount": "number",
        "penaltyDate": "timestamp",
        "createdBy": "string",
        "createdAt": "timestamp"
      },
      "optionalFields": ["sourceType", "sourceId"]
    },
    "companyRules": {
      "documentId": "auto or stable seed ID",
      "requiredFields": {
        "title": "string",
        "content": "string",
        "order": "integer",
        "isActive": "boolean",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
    "notifications": {
      "documentId": "auto",
      "requiredFields": {
        "employeeId": "string",
        "title": "string",
        "message": "string",
        "type": "info | success | warning | error",
        "isRead": "boolean",
        "createdAt": "timestamp"
      }
    },
    "notificationDevices": {
      "path": "employees/{uid}/notificationDevices/{fid}",
      "documentId": "Firebase Installation ID (FID)",
      "requiredFields": {
        "employeeId": "Firebase Authentication UID",
        "fid": "Firebase Installation ID",
        "platform": "browser user-agent string (max 300 characters)",
        "permission": "granted",
        "createdAt": "timestamp",
        "updatedAt": "timestamp",
        "lastSeenAt": "timestamp"
      }
    },
    "pushDispatches": {
      "documentId": "deterministic workflow review ID",
      "access": "Firebase Admin SDK only; client rules deny all access",
      "requiredFields": {
        "source": "workSchedules | leaveRequests | lateRequests | salaryAdvances",
        "sourceId": "string",
        "employeeId": "Firebase Authentication UID",
        "status": "string",
        "state": "queued | sent | partial | no-devices | failed",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
    "weeklyScheduleTargets": {
      "documentId": "Monday in YYYY-MM-DD format",
      "access": "Firebase Admin SDK only; client rules deny all access",
      "requiredFields": {
        "weekStart": "YYYY-MM-DD string",
        "expectedEmployees": "integer from 1 to 1000",
        "updatedBy": "manager/admin Firebase Authentication UID",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
    "workflowRequests": {
      "documentId": "employee UID + client request ID",
      "access": "Firebase Admin SDK only; client rules deny all access",
      "requiredFields": {
        "employeeId": "Firebase Authentication UID",
        "action": "submitSchedules | replaceSchedules | submitLeave | submitLate | submitSalaryAdvance",
        "targetIds": "array of created document IDs",
        "penaltyId": "string or null",
        "createdAt": "timestamp"
      }
    }
  }
}
