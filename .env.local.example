# Firebase Configuration
# Get these values from your Firebase project settings
# https://firebase.google.com/docs/web/setup

# Public Firebase Config (safe to expose in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key_here

# Firebase Admin SDK - SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
FIREBASE_ADMIN_PROJECT_ID=employee-management-port-339fe
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@employee-management-port-339fe.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Company workflow policy (server only)
SCHEDULE_DEADLINE_HOUR=18
PENALTY_LATE_SCHEDULE_AMOUNT=500
LEAVE_NOTICE_HOURS=24
PENALTY_REJECTED_LEAVE_AMOUNT=500
PENALTY_LATE_LEAVE_APPROVED_AMOUNT=500
PENALTY_LATE_LEAVE_REJECTED_AMOUNT=1000
PENALTY_SAME_DAY_SCHEDULE_CHANGE_AMOUNT=1000
PENALTY_LATE_NOTICE_AMOUNT=500

# Weekly Google Drive archive - SERVER ONLY
# Use an OAuth Web client and grant only the drive.file scope.
GOOGLE_DRIVE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_oauth_refresh_token

# Vercel sends this value as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=generate_a_random_secret_with_at_least_16_characters

# Keep false for the first run. After verifying the JSON file in Drive, set true.
WEEKLY_ARCHIVE_DELETE_ENABLED=false
MONTHLY_ARCHIVE_DELETE_ENABLED=false

# Tamper-evident audit trail. Set false only as an emergency kill switch.
AUDIT_TRAIL_ENABLED=true

# Employee receipt email. Both this environment switch and the Admin toggle
# must be enabled before any new receipt is queued or sent.
AUDIT_EMAIL_ENABLED=false
GMAIL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token_with_gmail_send_scope
GMAIL_FROM_EMAIL=your-sender@gmail.com
GMAIL_FROM_NAME=Trí Candy
# Email nhận cảnh báo Firebase, Drive và cron. Nếu bỏ trống, dùng GMAIL_FROM_EMAIL.
OPERATIONS_ALERT_EMAIL=lamhuynhthientri@gmail.com
# Ngưỡng tham chiếu Firestore; mặc định tương ứng mức miễn phí Standard.
FIRESTORE_READ_ALERT_LIMIT=50000
FIRESTORE_WRITE_ALERT_LIMIT=20000
FIRESTORE_DELETE_ALERT_LIMIT=20000
FIRESTORE_STORAGE_ALERT_LIMIT_BYTES=1073741824
# Trang Facebook hoặc liên kết m.me chính xác của quản lý để nhân viên liên hệ.
NEXT_PUBLIC_MANAGER_FACEBOOK_URL=https://m.me/ten-facebook-quan-ly
