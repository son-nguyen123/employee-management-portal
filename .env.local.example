# Firebase Configuration
# Get these values from your Firebase project settings
# https://firebase.google.com/docs/web/setup

# Public Firebase Config (safe to expose in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key_here

# Firebase Admin SDK - SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
FIREBASE_ADMIN_PROJECT_ID=employee-management-port-339fe
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@employee-management-port-339fe.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Company workflow policy (server only)
SCHEDULE_DEADLINE_HOUR=18
PENALTY_LATE_SCHEDULE_AMOUNT=50000
LEAVE_NOTICE_HOURS=24
PENALTY_LATE_LEAVE_AMOUNT=50000
PENALTY_LATE_NOTICE_AMOUNT=1000
